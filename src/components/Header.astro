---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, stripLocale, type Locale } from '../i18n/utils';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = useTranslations(locale);

const navItems = [
  { path: '/', key: 'nav.home' },
  { path: '/about', key: 'nav.about' },
  { path: '/news', key: 'nav.news' },
  { path: '/awards', key: 'nav.awards' },
  { path: '/writeups', key: 'nav.writeups' },
  { path: '/join', key: 'nav.join' },
  { path: '/contact', key: 'nav.contact' },
] as const;

function localized(path: string) {
  return getRelativeLocaleUrl(locale, path);
}

const targetLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const switchUrl = getRelativeLocaleUrl(targetLocale, stripLocale(Astro.url.pathname));

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(path: string) {
  const href = localized(path).replace(/\/$/, '') || '/';
  return currentPath === href;
}
---

<header class="header">
  <div class="container header-inner">
    <a href={localized('/')} class="brand">
      <img src="/logo.png" alt={`${t('site.name')} Logo`} class="brand-logo" width="36" height="36" />
      <span class="brand-text">
        <span class="brand-name">{t('site.name')}</span>
        <span class="brand-en">{t('site.shortName')}</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="主导航">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={localized(item.path)}
                class:list={['nav-link', { active: isActive(item.path) }]}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={switchUrl} class="lang-switch" aria-label="切换语言">{t('lang.switch')}</a>
      <button
        class="icon-btn"
        id="themeToggle"
        type="button"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      </button>
      <button class="nav-toggle" id="navToggle" aria-label="切换菜单" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--heading);
    flex-shrink: 1;
    min-width: 0;
  }

  .brand:hover {
    color: var(--heading);
  }

  .brand-logo {
    border-radius: 8px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    display: inline-block;
  }

  .brand:hover .brand-name {
    animation: glitch 0.4s steps(2, end) both;
  }

  @keyframes glitch {
    0% {
      text-shadow: 1px 0 var(--accent), -1px 0 var(--primary);
    }
    25% {
      text-shadow: -1px 0 var(--accent), 1px 0 var(--primary);
    }
    50% {
      text-shadow: 1px 0 var(--primary), -1px 0 var(--accent);
    }
    75% {
      text-shadow: -1px 0 var(--primary), 1px 0 var(--accent);
    }
    100% {
      text-shadow: none;
    }
  }

  .brand-en {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--primary);
    background: var(--primary-soft);
  }

  .nav-link.active {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lang-switch {
    color: var(--text);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .lang-switch:hover {
    color: var(--primary);
    background: var(--primary-soft);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .icon-btn:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--heading);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  @media (max-width: 920px) {
    .nav-toggle {
      display: flex;
    }

    .nav {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: none;
    }

    .nav.open {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      padding: 0.5rem 1rem 1rem;
    }

    .nav-link {
      display: block;
      padding: 0.7rem 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .brand-en {
      display: none;
    }

    .brand-name {
      font-size: 0.95rem;
      letter-spacing: 0;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* ignore */
    }
  });
</script>