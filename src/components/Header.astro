---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, stripLocale, type Locale } from '../i18n/utils';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = useTranslations(locale);

const navItems = [
  { path: '/', key: 'nav.home' },
  { path: '/about', key: 'nav.about' },
  { path: '/news', key: 'nav.news' },
  { path: '/awards', key: 'nav.awards' },
  { path: '/writeups', key: 'nav.writeups' },
  { path: '/join', key: 'nav.join' },
  { path: '/contact', key: 'nav.contact' },
] as const;

function localized(path: string) {
  return getRelativeLocaleUrl(locale, path);
}

const targetLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const switchUrl = getRelativeLocaleUrl(targetLocale, stripLocale(Astro.url.pathname));

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(path: string) {
  const href = localized(path).replace(/\/$/, '') || '/';
  return currentPath === href;
}
---

<header class="header">
  <div class="container header-inner">
    <a href={localized('/')} class="brand">
      <img src="/logo-mark.png" alt={`${t('site.name')} Logo`} class="brand-logo" width="34" height="34" />
      <span class="brand-text">
        <span class="brand-name">{locale === 'en' ? t('site.shortName') : t('site.name')}</span>
        <span class="brand-en">{locale === 'en' ? 'Cybersecurity Lab' : t('site.shortName')}</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label={t('nav.label')}>
      <ul>
        {
          navItems.map((item) => {
            const active = isActive(item.path);
            return (
              <li>
                <a
                  href={localized(item.path)}
                  class:list={['nav-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={switchUrl} class="lang-switch" aria-label={locale === 'zh' ? 'Switch to English' : '切换为中文'}>
        {t('lang.switch')}
      </a>
      <button
        class="icon-btn"
        id="themeToggle"
        type="button"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      </button>
      <button
        class="nav-toggle"
        id="navToggle"
        type="button"
        aria-label={t('nav.open')}
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<dialog class="Drawer" id="mobileDrawer" aria-label={t('nav.drawer')}>
  <div class="Drawer-scroller">
    <nav class="Drawer-sheet" aria-label={t('nav.label')}>
      <div class="Drawer-head">
        <a href={localized('/')} class="Drawer-brand">
          <img src="/logo-mark.png" alt="" width="28" height="28" aria-hidden="true" />
          <span>{t('site.shortName')}</span>
        </a>
        <button class="Drawer-close" id="drawerClose" type="button" aria-label={t('nav.close')} autofocus>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
        </button>
      </div>

      <ul class="Drawer-list">
        {
          navItems.map((item) => {
            const active = isActive(item.path);
            return (
              <li>
                <a
                  href={localized(item.path)}
                  class:list={['Drawer-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="Drawer-foot">
        <a href={switchUrl} class="Drawer-lang">
          {locale === 'zh' ? 'English Version' : '切换中文版'} ({t('lang.switch')})
        </a>
      </div>
    </nav>
  </div>
</dialog>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--heading);
    flex-shrink: 0;
    min-width: 0;
  }

  .brand:hover {
    color: var(--heading);
  }

  .brand-logo {
    border-radius: 8px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    display: inline-block;
    white-space: nowrap;
  }

  .brand:hover .brand-name {
    animation: glitch 0.4s steps(2, end) both;
  }

  @keyframes glitch {
    0% {
      text-shadow: 1px 0 var(--accent), -1px 0 var(--primary);
    }
    25% {
      text-shadow: -1px 0 var(--accent), 1px 0 var(--primary);
    }
    50% {
      text-shadow: 1px 0 var(--primary), -1px 0 var(--accent);
    }
    75% {
      text-shadow: -1px 0 var(--primary), 1px 0 var(--accent);
    }
    100% {
      text-shadow: none;
    }
  }

  .brand-en {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--primary);
    background: var(--primary-soft);
  }

  .nav-link[aria-current='page'] {
    color: var(--primary);
    background: var(--primary-soft);
    font-weight: 600;
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 999px;
    background: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lang-switch {
    color: var(--text);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.4rem 0.55rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .lang-switch:hover {
    color: var(--primary);
    background: var(--primary-soft);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .icon-btn:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0.45rem;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .nav-toggle:hover {
    background: var(--primary-soft);
    border-color: var(--border);
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--heading);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  @media (max-width: 1080px) {
    .nav-link {
      padding: 0.45rem 0.62rem;
      font-size: 0.9rem;
    }

    .nav-link[aria-current='page']::after {
      left: 0.62rem;
      right: 0.62rem;
    }
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .brand-en {
      display: none;
    }

    .brand-name {
      font-size: 1.05rem;
      letter-spacing: 0;
    }
  }

  /* ---------- Top-Layer 移动端抽屉菜单 ---------- */
  .Drawer {
    --drawer-width: min(19.5rem, 80dvw, 100dvw - 24px);
    --drawer-backdrop: 0;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .Drawer::backdrop {
    background: #000;
    opacity: calc(var(--drawer-backdrop) * 0.62);
    backdrop-filter: blur(4px);
  }

  .Drawer-scroller {
    position: relative;
    display: grid;
    grid-template-columns: var(--drawer-width) 100%;
    overflow-x: scroll;
    overscroll-behavior: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .Drawer-scroller::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .Drawer-scroller {
      scroll-behavior: smooth;
    }
  }

  .Drawer-scroller::after {
    content: '';
    scroll-snap-align: end;
    scroll-initial-target: nearest;
  }

  .Drawer-sheet {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100svh;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
    border-right: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow-y: auto;
    scroll-snap-align: start;
    scrollbar-width: none;
  }

  @supports (animation-timeline: scroll()) {
    .Drawer {
      timeline-scope: --drawer-fade;
      animation: fade-drawer-backdrop linear both;
      animation-timeline: --drawer-fade;
    }

    .Drawer-scroller {
      scroll-timeline: --drawer-fade x;
    }
  }

  .Drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .Drawer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--heading);
    font-weight: 700;
    font-size: 1rem;
  }

  .Drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .Drawer-close:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .Drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .Drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.78rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    font-size: 1rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .Drawer-link:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .Drawer-link[aria-current='page'] {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .Drawer-foot {
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .Drawer-lang {
    display: block;
    text-align: center;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .Drawer-lang:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }
</style>

<script>
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* ignore */
    }
  });

  const drawer = document.getElementById('mobileDrawer') as HTMLDialogElement | null;
  const openBtn = document.getElementById('navToggle');
  const closeBtn = document.getElementById('drawerClose');
  const scroller = drawer?.querySelector('.Drawer-scroller') as HTMLElement | null;
  const sheet = drawer?.querySelector('.Drawer-sheet') as HTMLElement | null;

  if (drawer && openBtn && closeBtn && scroller && sheet) {
    let isClosing = false;

    async function openDrawer() {
      if (!drawer || !scroller) return;
      isClosing = false;
      drawer.showModal();

      if (!CSS.supports('scroll-initial-target', 'nearest')) {
        scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'instant' as ScrollBehavior });
        await new Promise<void>((r) =>
          requestAnimationFrame(() => requestAnimationFrame(() => r())),
        );
      }

      scroller.scrollTo({ left: 0, behavior: 'auto' });
    }

    function closeDrawer() {
      if (!drawer || !scroller || !drawer.open || isClosing) return;
      isClosing = true;
      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
    }

    function onDrawerOpened() {
      openBtn?.setAttribute('aria-expanded', 'true');
    }

    function onDrawerClosed() {
      isClosing = false;
      if (drawer?.open) drawer.close();
      openBtn?.setAttribute('aria-expanded', 'false');
    }

    if (!CSS.supports('animation-timeline: scroll()')) {
      scroller.addEventListener(
        'scroll',
        () => {
          const width = sheet.offsetWidth || 1;
          const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / width));
          drawer.style.setProperty('--drawer-backdrop', String(ratio));
        },
        { passive: true },
      );
    }

    const visibleThreshold = Math.min(0.05, 1 / Math.max(window.innerWidth, 1));
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.at(-1);
        if (!entry) return;
        if (entry.intersectionRatio < visibleThreshold && drawer.open) {
          onDrawerClosed();
        }
        if (entry.intersectionRatio >= 0.99 && drawer.open) {
          onDrawerOpened();
        }
      },
      { root: drawer, threshold: [visibleThreshold, 0.99] },
    );
    observer.observe(sheet);

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);

    drawer.addEventListener('click', (event) => {
      if (!sheet.contains(event.target as Node)) closeDrawer();
    });

    drawer.addEventListener('cancel', (event) => {
      if (event.cancelable) {
        event.preventDefault();
        closeDrawer();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (drawer.open) drawer.close();
        openBtn.setAttribute('aria-expanded', 'false');
      });
    });

    const desktopMedia = window.matchMedia('(min-width: 961px)');
    desktopMedia.addEventListener('change', (e) => {
      if (e.matches && drawer.open) {
        drawer.close();
        openBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
