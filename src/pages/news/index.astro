---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postSlug } from '../../utils/abbrlink';

const posts = (await getCollection('news')).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="动态 · 新闻 · 活动" description="佛大网络安全实验室的动态、新闻与活动通知。">
  <section class="page-hero">
    <div class="container">
      <h1>动态 · 新闻 · 活动</h1>
      <p>实验室的最新动态、新闻与活动通知。</p>
    </div>
  </section>

  <section class="section">
    <div class="container list">
      {
        posts.length === 0 ? (
          <p class="empty">暂无内容，敬请期待。</p>
        ) : (
          posts.map((post, i) => (
            <a href={`/news/${postSlug(post)}`} class="card list-item">
              <span class="list-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="list-info">
                <div class="list-meta">
                  {post.data.pinned && <span class="badge badge-pinned">置顶</span>}
                  <span class="badge">{post.data.category}</span>
                  <time>{formatDate(post.data.date)}</time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="arrow">→</span>
            </a>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .list-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--text);
  }

  .list-item:hover {
    color: var(--text);
  }

  .list-index {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }

  .list-info {
    flex: 1;
    min-width: 0;
  }

  .list-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .list-meta time {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .list-info h3 {
    margin-bottom: 0.3rem;
  }

  .list-info p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.94rem;
  }

  .arrow {
    color: var(--primary);
    font-size: 1.3rem;
    flex-shrink: 0;
    align-self: center;
  }

  .empty {
    color: var(--text-muted);
  }
</style>