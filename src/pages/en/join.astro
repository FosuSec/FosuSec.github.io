---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { ctfTracks } from '../../data/tracks';
---

<BaseLayout title="Join Us" description={`Recruitment tracks, requirements and how to apply for ${site.nameEn} (${site.shortName}).`}>
  <!-- 招新横幅 -->
  <section class="join-hero">
    <div class="container">
      <p class="eyebrow">Recruitment · 招新</p>
      <h1 class="join-title">Join Us</h1>
      <p class="join-desc">
        Five tracks, one growth path — wherever you start, you'll find your place at FosuSec.
      </p>
      <div class="join-status">
        <span class="join-status-dot" aria-hidden="true"></span>
        <span>
          {site.recruitmentOpen ? 'Status: Open · Rolling recruitment' : 'Status: Closed · Stay tuned for updates'}
        </span>
      </div>
    </div>
  </section>

  <!-- 招新方向 -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">01 · Tracks</p>
      <h2 class="section-title">Recruitment Tracks</h2>
      <p class="section-subtitle">Five tracks covering the core topics and hands-on skills of CTF competitions.</p>
      <div class="tracks">
        {
          ctfTracks.map((track, i) => (
            <article class="track">
              <div class="track-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <div class="track-body">
                <div class="track-head">
                  <h3>{track.titleEn}</h3>
                  <span class="track-tag">{track.tag}</span>
                </div>
                <p>{track.descriptionEn}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 招新要求与收获 -->
  <section class="section section-soft">
    <div class="container">
      <p class="eyebrow">02 · Fit</p>
      <h2 class="section-title">Requirements</h2>
      <div class="grid-2">
        <div class="card">
          <h3>Who We're Looking For</h3>
          <ul>
            <li>Strong interest in cybersecurity and a willingness to dive deep;</li>
            <li>Basic programming skills (C / Python / Web, etc.);</li>
            <li>Self-driven learning and teamwork spirit;</li>
            <li>Open to all grades and majors.</li>
          </ul>
        </div>
        <div class="card">
          <h3>What You'll Gain</h3>
          <ul>
            <li>A structured learning path with mentorship from senior members;</li>
            <li>Opportunities to participate in CTF and security competitions;</li>
            <li>Hands-on projects and security research experience;</li>
            <li>Like-minded technical partners.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 报名方式 -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">03 · Apply</p>
      <h2 class="section-title">How to Apply</h2>
      <div class="prose">
        <p>
          {site.recruitmentOpen
            ? 'Recruitment is now open. Contact us via email or GitHub on the contact page with the subject "Join FosuSec", and we will reply soon.'
            : 'Recruitment is currently closed. Please follow our news for the latest announcements.'}
        </p>
        <p>
          Please include your profile, learning direction and relevant experience (if any) when applying.
        </p>
      </div>
      <div class="apply-cta">
        <a href="/en/contact" class="btn btn-primary">Go to Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 招新横幅（区别于首页 Hero） ---------- */
  .join-hero {
    background: linear-gradient(135deg, var(--primary-soft), var(--bg));
    border-bottom: 1px solid var(--border);
    padding: 4rem 0 3rem;
  }

  .join-title {
    background: none;
    -webkit-text-fill-color: var(--heading);
    color: var(--heading);
    transition: text-shadow 0.15s ease;
  }

  .join-title:hover {
    text-shadow: 2px 0 var(--accent), -2px 0 var(--primary);
  }

  .join-desc {
    color: var(--text-muted);
    max-width: 680px;
    margin: 0.75rem 0 0;
  }

  .join-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1.5rem;
  }

  .join-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
    animation: join-pulse 2s ease-in-out infinite;
  }

  @keyframes join-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .join-status-dot {
      animation: none;
    }
  }

  /* ---------- 方向列表（行式清单，区别于首页卡片网格） ---------- */
  .tracks {
    display: flex;
    flex-direction: column;
  }

  .track {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.15s ease;
  }

  .track:first-of-type {
    border-top: 1px solid var(--border);
  }

  .track-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .track-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .track-head h3 {
    margin: 0;
  }

  .track-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--primary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.08rem 0.6rem;
  }

  .track-body p {
    color: var(--text-muted);
    margin: 0;
    max-width: 780px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .card ul {
    margin-bottom: 0;
  }

  .apply-cta {
    max-width: 760px;
    margin: 1.5rem auto 0;
    text-align: right;
  }

  @media (max-width: 760px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }

    .track {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>