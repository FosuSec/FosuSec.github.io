---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { postSlug } from '../../../utils/abbrlink';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={post.data.titleEn ?? post.data.title} description={post.data.descriptionEn ?? post.data.description}>
  <article class="page-hero">
    <div class="container">
      <div class="post-meta">
        <span class="badge">{post.data.category}</span>
        <time>{formatDate(post.data.date)}</time>
      </div>
      <h1>{post.data.titleEn ?? post.data.title}</h1>
      <p>{post.data.descriptionEn ?? post.data.description}</p>
    </div>
  </article>

  <section class="section">
    <div class="container prose">
      <Content />
      <p><a href="/en/news">← Back to News</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-meta time {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>