---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="News" description="News, events and announcements from FosuSec.">
  <section class="page-hero">
    <div class="container">
      <h1>News & Events</h1>
      <p>Latest updates, news and event announcements from the lab.</p>
    </div>
  </section>

  <section class="section">
    <div class="container list">
      {
        posts.length === 0 ? (
          <p class="empty">No posts yet.</p>
        ) : (
          posts.map((post) => (
            <a href={`/en/news/${post.id}`} class="card list-item">
              <div class="list-info">
                <div class="list-meta">
                  <span class="badge">{post.data.category}</span>
                  <time>{formatDate(post.data.date)}</time>
                </div>
                <h3>{post.data.titleEn ?? post.data.title}</h3>
                <p>{post.data.descriptionEn ?? post.data.description}</p>
              </div>
              <span class="arrow">→</span>
            </a>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text);
  }

  .list-item:hover {
    color: var(--text);
  }

  .list-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .list-meta time {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .list-info h3 {
    margin-bottom: 0.3rem;
  }

  .list-info p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.94rem;
  }

  .arrow {
    color: var(--primary);
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .empty {
    color: var(--text-muted);
  }
</style>