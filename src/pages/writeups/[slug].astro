---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writeups');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="page-hero">
    <div class="container">
      <div class="post-meta">
        <span class="badge">{post.data.category}</span>
        <time>{formatDate(post.data.date)}</time>
        {post.data.author && <span class="author">作者：{post.data.author}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )
      }
    </div>
  </article>

  <section class="section">
    <div class="container prose">
      <Content />
      <p><a href="/writeups">← 返回 Writeups 列表</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .post-meta time,
  .author {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .tags {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .tag {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>