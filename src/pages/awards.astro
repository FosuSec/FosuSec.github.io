---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { getWebpDimensions } from '../utils/imageSize';

const awards = (await getCollection('awards')).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

let lastYear: number | null = null;
const groups = awards.map((entry, index) => {
  const year = entry.data.date?.getFullYear() ?? null;
  const isNewGroup = year !== null && year !== lastYear;
  lastYear = year;
  return {
    entry,
    year,
    isNewGroup,
    side: index % 2 === 0 ? 'left' : 'right',
    isLatest: index === 0,
  };
});

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
}

// 奖项图片统一存放在 public/awards/ 目录下，构建时自动扫描
const awardsImgDir = join(process.cwd(), 'public', 'awards');
const carouselImages = (() => {
  try {
    return readdirSync(awardsImgDir)
      .filter((name) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(name))
      .sort((a, b) => a.localeCompare(b, 'zh-CN', { numeric: true }))
      .map((name) => {
        const dims = getWebpDimensions(join(awardsImgDir, name));
        const width = dims ? Math.round((dims.width / dims.height) * 170) : 226;
        return { src: `/awards/${name}`, width, height: 170 };
      });
  } catch {
    return [];
  }
})();
---

<BaseLayout title="获奖 · 荣誉" description="FosuSec 在各类信息安全竞赛中取得的获奖与荣誉。">
  <section class="page-hero">
    <div class="container">
      <h1>获奖 · 荣誉</h1>
      <p>记录实验室在各类信息安全竞赛中的成绩与荣誉。</p>
    </div>
  </section>

  <!-- 奖项照片轮播（从右往左滚动） -->
  {carouselImages.length > 0 && (
    <section class="carousel" aria-label="奖项照片轮播">
      <span class="carousel-frame" aria-hidden="true"></span>
      <div class="carousel-track">
        {[...carouselImages, ...carouselImages].map((img, idx) => (
          <figure class="film-frame">
            <img
              src={img.src}
              alt=""
              width={img.width}
              height={img.height}
              loading={idx < 8 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      {
        awards.length === 0 ? (
          <p class="empty">暂无内容，敬请期待。</p>
        ) : (
          <div class="timeline">
            {
              groups.map(({ entry, year, isNewGroup, side, isLatest }) => (
                <>
                  {isNewGroup && year !== null && (
                    <div class="timeline-year">
                      <span>{year}</span>
                    </div>
                  )}
                  <div class={`award-item award-item--${side}${isLatest ? ' award-item--latest' : ''}`}>
                    <div class="award-year">{year ?? '—'}</div>
                    <div class="award-body">
                      <div class="award-head">
                        <h3>{entry.data.title}</h3>
                        <span class="badge badge-gold">{entry.data.award}</span>
                      </div>
                      {entry.data.description && <p>{entry.data.description}</p>}
                      {entry.data.date && <time>{formatDate(entry.data.date)}</time>}
                    </div>
                  </div>
                </>
              ))
            }
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .carousel {
    position: relative;
    width: 80%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--radius);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .carousel::before,
  .carousel::after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .carousel::before {
    left: 0;
    content: '‹';
    justify-content: flex-start;
    padding-left: 0.9rem;
    background: linear-gradient(to right, var(--bg-soft) 40%, transparent);
  }

  .carousel::after {
    right: 0;
    content: '›';
    justify-content: flex-end;
    padding-right: 0.9rem;
    background: linear-gradient(to left, var(--bg-soft) 40%, transparent);
  }

  .carousel-frame {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.35;
    transition: opacity 0.2s ease;
    background:
      linear-gradient(var(--primary), var(--primary)) left 8px top 8px / 14px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) left 8px top 8px / 1px 14px no-repeat,
      linear-gradient(var(--primary), var(--primary)) right 8px top 8px / 14px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) right 8px top 8px / 1px 14px no-repeat,
      linear-gradient(var(--primary), var(--primary)) left 8px bottom 8px / 14px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) left 8px bottom 8px / 1px 14px no-repeat,
      linear-gradient(var(--primary), var(--primary)) right 8px bottom 8px / 14px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) right 8px bottom 8px / 1px 14px no-repeat;
  }

  .carousel:hover .carousel-frame {
    opacity: 0.9;
  }

  .carousel:hover::before,
  .carousel:hover::after {
    color: var(--primary);
  }

  :global(:root[data-theme='dark']) .carousel:hover::before,
  :global(:root[data-theme='dark']) .carousel:hover::after {
    text-shadow:
      1px 0 0 rgba(255, 45, 85, 0.7),
      -1px 0 0 rgba(0, 210, 255, 0.7);
  }

  .carousel-track {
    display: flex;
    width: max-content;
    animation: carousel-scroll 60s linear infinite;
  }

  .film-frame {
    flex-shrink: 0;
    margin: 0 1rem 0 0;
    padding: 14px 0;
    background:
      repeating-linear-gradient(
          to right,
          var(--text-muted) 0 12px,
          transparent 12px 28px
        )
        center top 2px / 100% 10px no-repeat,
      repeating-linear-gradient(
          to right,
          var(--text-muted) 0 12px,
          transparent 12px 28px
        )
        center bottom 2px / 100% 10px no-repeat;
  }

  .film-frame img {
    display: block;
    height: 170px;
    width: auto;
    max-width: none;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    background: linear-gradient(
      90deg,
      var(--surface) 25%,
      var(--primary-soft) 50%,
      var(--surface) 75%
    );
    background-size: 200% 100%;
    animation: film-shimmer 1.5s ease-in-out infinite;
  }

  .film-frame img.is-loaded {
    animation: none;
    background: var(--surface);
  }

  @keyframes film-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .carousel:hover .carousel-track {
    animation-play-state: paused;
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
  }

  .timeline {
    position: relative;
    padding: 0.5rem 0 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, var(--primary-soft), var(--border));
  }

  .timeline-year {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0.5rem 0 1.75rem;
  }

  .timeline-year span {
    position: relative;
    z-index: 1;
    display: inline-block;
    padding: 0.35rem 1.5rem;
    border: 1px solid var(--primary);
    border-radius: 999px;
    background: var(--primary);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    color: var(--bg);
    box-shadow: 0 0 0 4px var(--primary-soft);
  }

  :global(:root[data-theme='dark']) .timeline-year span {
    box-shadow:
      0 0 0 4px var(--primary-soft),
      0 0 24px rgba(255, 255, 255, 0.35);
  }

  .award-item {
    position: relative;
    box-sizing: border-box;
    display: flex;
    gap: 1rem;
    width: 50%;
    padding-bottom: 2.5rem;
  }

  .award-item:last-child {
    padding-bottom: 0;
  }

  .award-item--left {
    padding-right: 44px;
    flex-direction: row-reverse;
    text-align: right;
  }

  .award-item--right {
    left: 50%;
    padding-left: 44px;
    flex-direction: row;
    text-align: left;
  }

  .award-item::before {
    content: '';
    position: absolute;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
    box-shadow: 0 0 0 4px var(--primary-soft);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .award-item--left::before {
    right: -8px;
  }

  .award-item--right::before {
    left: -8px;
  }

  .award-item:hover::before {
    background: var(--primary);
    transform: scale(1.15);
  }

  .award-item--latest::before {
    animation: node-pulse 2.4s ease-out infinite;
  }

  @keyframes node-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px var(--primary-soft);
    }

    50% {
      box-shadow: 0 0 0 8px var(--primary-soft);
    }
  }

  .award-year {
    flex-shrink: 0;
    width: 56px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--primary);
    line-height: 1.6;
    padding-top: 2px;
  }

  .award-item--left .award-year {
    text-align: right;
  }

  .award-item--right .award-year {
    text-align: left;
  }

  .award-body {
    flex: 1;
    min-width: 0;
  }

  .award-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .award-item--left .award-head {
    justify-content: flex-end;
  }

  .award-item--right .award-head {
    justify-content: flex-start;
  }

  .award-head h3 {
    margin: 0;
  }

  .award-body p {
    margin: 0 0 0.3rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .award-body time {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .carousel {
      width: 100%;
    }

    .timeline::before {
      left: 16px;
      transform: none;
    }

    .timeline-year {
      justify-content: flex-start;
    }

    .timeline-year span {
      margin-left: 14px;
    }

    .award-item,
    .award-item--left,
    .award-item--right {
      left: 0;
      width: 100%;
      flex-direction: row;
      text-align: left;
      padding: 0 0 2rem 40px;
    }

    .award-item--left::before,
    .award-item--right::before {
      left: 8px;
      right: auto;
    }

    .award-item--left .award-year,
    .award-item--right .award-year {
      text-align: left;
    }

    .award-item--left .award-head,
    .award-item--right .award-head {
      justify-content: flex-start;
    }

    .award-item:last-child {
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .film-frame img {
      animation: none;
    }

    .award-item::before {
      transition: none;
    }

    .award-item:hover::before {
      transform: none;
    }

    .award-item--latest::before {
      animation: none;
    }
  }

  .empty {
    color: var(--text-muted);
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.film-frame img').forEach(function (img) {
      if (img.complete) {
        img.classList.add('is-loaded');
      } else {
        img.addEventListener('load', function () {
          img.classList.add('is-loaded');
        }, { once: true });
      }
    });
  })();
</script>